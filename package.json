{
  "name": "web-toolbox",
  "version": "4.8.0",
  "author": "amwebexpert@gmail.com",
  "repository": "https://github.com/amwebexpert/etoolbox",
  "contributors": [
    {
      "name": "André Masson",
      "email": "amwebexpert@gmail.com",
      "url": "https://amwebexpert.github.io/amwebexpert"
    },
    {
      "name": "Anthony Buchholz",
      "email": "anthony.buchholz@gmail.com",
      "url": "https://yodigi7.github.io/"
    }
  ],
  "description": "Collection of web development utilities. Like a Swiss knife for web developers.",
  "homepage": ".",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare": "husky",
    "clean:node": "npx rimraf node_modules bun.lock",
    "start": "bun run dev",
    "dev": "vite",
    "typecheck": "npx tsc --noEmit --project tsconfig.app.json",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 rimraf dist && bun run generate:version && tsc -b && vite build",
    "lint": "habit-hooks",
    "lint:ci": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:unused": "knip",
    "preview": "vite preview",
    "deploy": "rimraf dist && bun run build && rimraf docs && shx mv dist docs",
    "generate:version": "node scripts/generate-version",
    "generate:api:client": "npx @hey-api/openapi-ts -i ./public/openapi/openapi.json -o ./src/api/generated --client @hey-api/client-axios",
    "test": "vitest",
    "lint-staged": "lint-staged",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint:package": "npmPkgJsonLint .",
    "habit:hooks": "habit-hooks --branch main",
    "habit:hooks:full": "habit-hooks",
    "habit:snoozed": "habit-snooze --list",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "ai:run:plan": "npx tsx ai-orchestrator/main.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ant-design/icons": "6.2.3",
    "@lichens-innovation/ts-common": "1.18.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.15",
    "@types/three": "0.184.1",
    "@uidotdev/usehooks": "2.4.1",
    "@xenova/transformers": "2.17.2",
    "antd": "6.4.3",
    "antd-style": "4.1.0",
    "buffer": "6.0.3",
    "compressorjs": "1.3.0",
    "compute-cosine-similarity": "1.1.0",
    "date-fns": "4.4.0",
    "dayjs": "1.11.21",
    "diff": "9.0.0",
    "httpsnippet": "3.0.10",
    "immer": "11.1.8",
    "js-beautify": "1.15.4",
    "json5": "2.2.3",
    "jsonrepair": "3.14.0",
    "jsqr": "1.4.0",
    "jwt-decode": "4.0.0",
    "mime": "4.1.0",
    "mime-db": "1.54.0",
    "papaparse": "5.5.3",
    "parse-curl": "0.2.6",
    "path-browserify": "1.0.1",
    "pino": "10.3.1",
    "pretty-bytes": "7.1.0",
    "qrcode": "1.5.4",
    "querystring-es3": "0.2.1",
    "quicktype-core": "23.2.6",
    "re-resizable": "6.11.2",
    "react": "19.2.7",
    "react-diff-viewer-continued": "4.2.2",
    "react-dom": "19.2.7",
    "react-json-view": "1.21.3",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "reconnecting-websocket": "4.4.0",
    "stream-browserify": "3.0.0",
    "string_decoder": "1.3.0",
    "tesseract.js": "7.0.0",
    "three": "0.184.0",
    "url": "0.11.4",
    "uuid": "14.0.0",
    "vitest": "4.1.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.7.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.168",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "10.0.1",
    "@lichens-innovation/eslint-plugin-coding-guide": "1.0.3",
    "@types/js-beautify": "1.14.3",
    "@types/mime-db": "1.43.6",
    "@types/node": "25.9.2",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.0.2",
    "commitlint": "21.0.2",
    "conventional-changelog-cli": "3.0.0",
    "conventional-recommended-bump": "4.1.1",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "17.0.7",
    "npm-package-json-lint": "10.4.1",
    "patch-package": "8.0.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "shx": "0.4.0",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "package.json": [
      "npmPkgJsonLint",
      "prettier --write"
    ],
    "src/**/*.{css,json,md}": "prettier --write"
  }
}
