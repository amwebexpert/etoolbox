# eslint-plugin-react@7.37.5 — ESLint 10 compatibility
# context.getFilename() was removed in ESLint 10 (use context.filename instead).
# This patch uses context.filename ?? context.getFilename?.() in resolveBasedir()
# so the plugin works with both ESLint 8/9 and ESLint 10. Remove when upstream
# supports ESLint 10.
